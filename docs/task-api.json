  "paths": {
    "/api/tasks": {
      "post": {
        "summary": "Create a new task",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title_tasks": {
                    "type": "string"
                  },
                  "tasks_description": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": ["pending", "in_progress", "completed"]
                  }
                },
                "required": ["title_tasks", "tasks_description", "status"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success create tasks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "number"
                        },
                        "title_tasks": {
                          "type": "string"
                        },
                        "tasks_description": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": ["pending", "in_progress", "completed"]
                        }
                      }
                    },
                    "errors": {
                      "type": "object",
                      "nullable": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },

